# Copy to .env.local for local development (git-ignored).
# Both variables are REQUIRED - the app throws at startup without WAKALAH_API_BASE.
# Local backend:
WAKALAH_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_WAKALAH_WS_URL=ws://127.0.0.1:8000/ws
# Hosted backend (Render) - set these in the Vercel dashboard instead:
# WAKALAH_API_BASE=https://wakalah.onrender.com
# NEXT_PUBLIC_WAKALAH_WS_URL=wss://wakalah.onrender.com/ws
