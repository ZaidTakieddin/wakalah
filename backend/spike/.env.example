# Copy to .env (git-ignored) and fill in. NEVER commit the real key.
RAPIDAPI_KEY=
# Defaults below match the NaC-on-RapidAPI setup observed via the MCP on 2026-07-06.
# If calls 401/404, copy the exact base URL + host from your RapidAPI NaC endpoint page.
NAC_BASE_URL=https://network-as-code.p-eu.rapidapi.com
NAC_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
# Official simulator roster (portal API overview):
#   +99999991000 = "compromised" persona (swapped/forwarding/recycled/roaming, verify=FALSE)
#   +99999991001 = "clean" persona (all signals negative, verify=TRUE)
#   +999999904xx / +999999905xx = return that HTTP error code (400/404/422/500/502/503/504)
# NAI form: 8D8AC610-566D-4EF0-9C22-186B2A5ED793-1000@testcsp.net (suffix matches number)
DEVICE_PHONE=+99999991000
DEVICE_NAI=8D8AC610-566D-4EF0-9C22-186B2A5ED793-1000@testcsp.net
# Webhook sink for subscription tests — replace with a cloudflared/ngrok tunnel URL
# when testing real event delivery
SINK_URL=https://example.com/nac-sink
# Set to 1 to also test QoD session + geofencing subscription create/delete
SPIKE_MUTATIONS=0
