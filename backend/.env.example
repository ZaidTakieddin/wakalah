# Copy to backend/.env (git-ignored) and fill in. NEVER commit the real values.

# --- Nokia Network as Code (RapidAPI) ---------------------------------------
RAPIDAPI_KEY=
NAC_BASE_URL=https://network-as-code.p-eu.rapidapi.com
NAC_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com

# --- Number Verification consent (3-legged OAuth, docs/02 D23) ---------------
# Defaults match the spike-proven sandbox behaviour; override only if the
# operator changes the flow.
# NV_SCOPE=dpv:FraudPreventionAndDetection number-verification:verify
# NV_REDIRECT_URI=https://example.com/redirect

# --- Operations --------------------------------------------------------------
# NAC_MODE=live            # live | replay (replay = offline demo fallback)
# NAC_RECORD=true          # record live responses into backend/replay_cache/
# NAC_CACHE_TTL_SECONDS=0  # reuse fresh answers labelled cached; 0 = every call real

# --- Supabase (server-side ONLY — the frontend never sees these) ------------
SUPABASE_URL=https://gltbzawnxifopetuufjg.supabase.co
# Service-role key from: Supabase dashboard -> Project Settings -> API keys.
# This key bypasses RLS — backend only, never in frontend code or git.
SUPABASE_SERVICE_KEY=

# --- Agent brains (Tooling-Guide approved, free tiers) -----------------------
GEMINI_API_KEY=
GROQ_API_KEY=
# Local fallback (no key needed): OLLAMA_BASE_URL=http://localhost:11434
